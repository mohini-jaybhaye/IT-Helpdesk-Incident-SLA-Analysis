Total Tickets = COUNTROWS(Fact_Tickets)

SLA Compliance % = DIVIDE([Resolved Tickets]-[SLA Breached],[Resolved Tickets])

MTTR (Hrs) = AVERAGE(Fact_Tickets[Resolution_Hours])

MTTR Target (Hrs) = 16

Open Tickets = CALCULATE([Total Tickets], ISBLANK(Fact_Tickets[Resolution_Timestamp]))



